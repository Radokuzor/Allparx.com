GOOGLE_PLACES_API_KEY=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
NEXT_PUBLIC_SITE_URL=https://allparx.com
# Separate from GOOGLE_PLACES_API_KEY: this one ships to the browser in the map
# iframe, so restrict it to the Maps Embed API and the allparx.com referrer.
# The Embed API is free and unlimited. Without it, place pages omit the map.
NEXT_PUBLIC_GOOGLE_MAPS_EMBED_KEY=
# Telegram bot that posts a visit notification every 10th page view (src/proxy.ts).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Password for /analytics. Without it the dashboard falls back to a default
# that is public knowledge, and the dashboard exposes visitor IP addresses.
ANALYTICS_PASSWORD=
# Verification tokens from Google Search Console and Bing Webmaster Tools.
# These are the only source of search *queries* — referrers never carry them.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_BING_SITE_VERIFICATION=

# --- Accounts -------------------------------------------------------------
# Firebase *web app* config. Add a Web App in the Firebase console (Project
# settings → Your apps → Web) — the server credentials above do not include
# these. All three ship to the browser, which is expected: they identify the
# project, they do not authorise anything. Without them the sign-in UI hides
# itself rather than erroring.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_APP_ID=
# Secret mixed into every stored sign-in code hash, so a database dump cannot
# be replayed. Any long random string; changing it invalidates codes in flight.
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_OTP_PEPPER=
# Who sign-in codes come from. Must be a domain the sender below is allowed to
# send for, or DMARC will file the codes as spam.
EMAIL_FROM=AllParx <no-reply@allparx.com>
# Option A — any mailbox you own. Free, no new account. For Gmail this is an
# App Password, not the account password, and caps at ~500 messages a day.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Option B — Resend. Used only when the SMTP settings above are blank.
# Needs the SPF/DKIM records it gives you added to the allparx.com DNS.
RESEND_API_KEY=
